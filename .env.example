# Copy this file to the repository-root .env, or use deployment secrets.
# FastAPI loads it automatically; existing system environment values win.
# Never commit your real .env file.
PROJECT_NAME="Pathwaay Career Explorer"
# Optional: RunPod Serverless endpoint for career inference.
# Backend-only key shared by SDG GLM and Feature 4 discovery.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Optional GLM-5.3 endpoint override. Blank uses the existing team default.
# Do not put the GLM endpoint in RUNPOD_ENDPOINT_ID (the separate RF model).
RUNPOD_LLM_ENDPOINT_ID=

# Feature 4 uses the same GLM endpoint and shared client; never the RF endpoint.
# Backend-only Tavily Search/Extract key. Blank retains local fallback.
TAVILY_API_KEY=
FEATURE4_DYNAMIC_DISCOVERY_ENABLED=true
FEATURE4_MAX_SEARCH_QUERIES=3
FEATURE4_MAX_CANDIDATE_URLS=8
FEATURE4_DISCOVERY_CACHE_TTL_HOURS=168
FEATURE4_DISCOVERY_DEADLINE_SECONDS=25

# AI Trend Signal: public evidence is populated in the background on startup.
# Set 0 for offline development/tests or when using an external refresh job.
AI_TREND_AUTO_REFRESH=1
# Dedicated free OpenAlex budget; avoids sharing a hosted server's anonymous quota.
OPENALEX_API_KEY=
# Opt in to paid, bounded RunPod evidence interpretation. Requires RUNPOD_API_KEY.
EVIDENCE_LLM_ENABLED=0
